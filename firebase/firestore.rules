rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function clinician() { return signedIn() && request.auth.token.role in ['clinician','admin']; }
    match /patients/{patientId} {
      allow read, write: if clinician();
      match /assessments/{assessmentId} { allow read, write: if clinician(); }
    }
    match /alerts/{alertId} { allow read, write: if clinician(); }
    match /articles/{articleId} { allow read: if signedIn(); allow write: if clinician(); }
    match /{document=**} { allow read, write: if false; }
  }
}
